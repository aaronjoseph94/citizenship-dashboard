{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare Workers (static assets only, no server code). The app has no client-side
  // routes, so unknown paths get a plain 404 rather than an SPA fallback.
  "name": "citizenship-dashboard",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist"
  }
}
